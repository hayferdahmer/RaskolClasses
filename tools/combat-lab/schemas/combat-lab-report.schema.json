{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raskolclasses.invalid/schemas/combat-lab-report.schema.json",
  "title": "RaskolClasses Combat Lab report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_type", "simulator_version", "scenario_set", "source_commit", "seed", "iterations_per_scenario", "generated_at", "scenarios"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "report_type": { "const": "combat-lab-report" },
    "simulator_version": { "type": "string", "minLength": 1 },
    "scenario_set": { "type": "string", "minLength": 1 },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "seed": { "type": "integer", "minimum": 0 },
    "iterations_per_scenario": { "type": "integer", "minimum": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario_id", "mode", "sample_count", "metrics", "invariant_violations"],
        "properties": {
          "scenario_id": { "type": "string", "minLength": 1 },
          "mode": { "enum": ["pvp", "pve"] },
          "sample_count": { "type": "integer", "minimum": 1 },
          "invariant_violations": { "type": "array", "items": { "type": "string" } },
          "metrics": {
            "type": "object",
            "required": ["win_rate", "ttk_median_seconds", "dps_mean", "hps_mean", "proc_rate", "pet_damage_share", "resource_waste_pct"],
            "properties": {
              "win_rate": { "$ref": "#/$defs/rate" },
              "ttk_median_seconds": { "$ref": "#/$defs/nonNegativeMetric" },
              "dps_mean": { "$ref": "#/$defs/nonNegativeMetric" },
              "hps_mean": { "$ref": "#/$defs/nonNegativeMetric" },
              "proc_rate": { "$ref": "#/$defs/rate" },
              "pet_damage_share": { "$ref": "#/$defs/rate" },
              "resource_waste_pct": { "$ref": "#/$defs/rate" }
            },
            "additionalProperties": false
          }
        }
      }
    }
  },
  "$defs": {
    "rate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "ci95_low", "ci95_high"],
      "properties": {
        "value": { "type": "number", "minimum": 0, "maximum": 1 },
        "ci95_low": { "type": "number", "minimum": 0, "maximum": 1 },
        "ci95_high": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "nonNegativeMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "ci95_low", "ci95_high"],
      "properties": {
        "value": { "type": "number", "minimum": 0 },
        "ci95_low": { "type": "number", "minimum": 0 },
        "ci95_high": { "type": "number", "minimum": 0 }
      }
    }
  }
}

<!--
  1.14.13 (Sprint 9, Волна 13A): исключения SpotBugs по итогам триажа отчёта.
  1.14.14 (фаза 1): расширено правилами для test-only классов (BalanceSimulator,
  SelftestRunner) и пет-бэклога (PetService$PetState).
  1.14.14 (фаза 2): HE_INHERITS_EQUALS_USE_HASHCODE для *Placeholder закрыт
  точечным exclude — equals(Object) final в апстрим-PlaceholderExpansion,
  переопределение невозможно; hashCode апстрим не предоставляет.
  1.15.7 (Волна 7c): правило URF_UNREAD_FIELD для PetService$PetState УДАЛЕНО —
  мёртвые поля dmgMult/speedMult удалены из кода (более не «бэклог пет-damage»,
  а устранённый дефект). Комментарии бэклогов актуализированы по датам.

  Каждое правило — осознанное решение, а не «заглушить шум»; причины зафиксированы
  в комментариях и в CHANGELOG.

  Бэклог Волны 8 (аудит 2.15-1, НЕ закрыто):
   - сузить глобальные exclude (EI_EXPOSE_REP/2, NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE,
     RCN_REDUNDANT_NULLCHECK, MS_PKGPROTECT, RV_RETURN_VALUE_IGNORED) до классов
     по свежему spotbugsXml.xml из analyze-job;
   - перевести analyze-job с continue-on-error на блокирующий гейт после двух
     подряд релизов с нулём находок сверх исключений.

  Лицензия: RASKOL Proprietary License v2.0.
-->
<FindBugsFilter>

    <!-- Тестовый код: высокий порог шума, не блокируем билд -->
    <Match>
        <Source name="~.*Test\.java"/>
    </Match>

    <!--
      EI_EXPOSE_REP / EI_EXPOSE_REP2 (CWE-374, rank 18):
      Bukkit-плагин — доверенная однопоточная по записи среда без untrusted-вызывающих.
      (а) конструкторы хранят ссылку на RaskolClasses/сервисы — канонический DI-паттерн
          платформы, синглтон жизненного цикла сервера;
      (б) геттеры-локаторы RaskolClasses/CombatService/AttributeService отдают живые
          сервисы осознанно (сервис-локатор, аудит 4-02; замена на инъекции — план 1.15.x);
      (в) Bukkit-события (CustomHealEvent) обязаны отдавать живые Player/LivingEntity;
      (г) коллекции моделей Spec2Node/Spec2Tree/GearStats построены из иммутабельных
          литералов (Map.of/List.of) при старте реестра и не мутируют после; защитные
          копии в hot-петлях рендера книги дали бы аллокации на каждый клик.
      Волна 8: сузить до классов-владелцев живых сервисов по отчёту.
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!--
      RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE: оборонительные null-проверки оставлены
      намеренно (SelftestRunner.mathBasics, VanillaDamageListener.hasGearWeaponTag):
      ноль стоимости в рантайме, страховка от смены контрактов API в будущих версиях Paper.
    -->
    <Match>
        <Bug pattern="RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE"/>
    </Match>

    <!--
      NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE: во всех разобранных экземплярах
      null-guard стоит явно; остаточные пути — ложные срабатывания на контрактах
      Bukkit-геттеров (priority 2, rank 13–18 = низкая достоверность детектора).
      Волна 8: сузить до классов с вызовами getPlayer/getEntity по отчёту.
    -->
    <Match>
        <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
    </Match>

    <!--
      MS_PKGPROTECT: BookSlots.GEAR_SET_SLOTS и подобные public static final int[] —
      константы раскладки GUI; final защищает от перезаписи ссылки, содержимое
      массива не мутирует после старта. Реальный риск = 0.
    -->
    <Match>
        <Bug pattern="MS_PKGPROTECT"/>
    </Match>

    <!--
      RV_RETURN_VALUE_IGNORED_NO_SIDE_EFFECT: косметика стиля в hotbar-слое.
      1.15.7: ревизия выполнена — игнорируемые возвраты ограничены декоративными
      вызовами (setItemMeta-цепочки hotbar); семантики не несут. Исключение сохранено
      до Волны 8, где hotbar-слой получит явные проверки в рамках гигиены.
    -->
    <Match>
        <Bug pattern="RV_RETURN_VALUE_IGNORED_NO_SIDE_EFFECT"/>
    </Match>

    <!-- ================================================================ -->
    <!-- 1.14.14 (фаза 1): правила для test-only                          -->
    <!-- ================================================================ -->

    <!--
      FE_FLOATING_POINT_EQUALITY / FL_FLOATS_AS_LOOP_COUNTERS в test-слое:
      BalanceSimulator (TTK-симуляция дуэлей) и SelftestRunner (headless-проверка
      формул) оперируют точными значениями из формул; равенства там осознанные,
      не требуют epsilon. Боевой код (VanillaDamageListener) исправлен в фазе 2
      epsilon-сравнением и НЕ исключён.
    -->
    <Match>
        <Class name="dev.raskol.classes.balance.BalanceSimulator"/>
        <Bug pattern="FE_FLOATING_POINT_EQUALITY,FL_FLOATS_AS_LOOP_COUNTERS"/>
    </Match>
    <Match>
        <Class name="dev.raskol.classes.selftest.SelftestRunner"/>
        <Bug pattern="FE_FLOATING_POINT_EQUALITY"/>
    </Match>

    <!-- ================================================================ -->
    <!-- 1.14.14 (фаза 2): апстрим-ограничение PlaceholderAPI             -->
    <!-- ================================================================ -->

    <!--
      HE_INHERITS_EQUALS_USE_HASHCODE для расширений PlaceholderAPI:
      в PlaceholderAPI 2.11.6 метод equals(Object) объявлен FINAL в
      me.clip.placeholderapi.expansion.PlaceholderExpansion (переопределение =
      compile error "overridden method is final"), при этом hashCode() апстрим
      НЕ предоставляет — любой сабкласс наследует final-equals + Object.hashCode,
      т.е. находка воспроизводится для ВСЕХ расширений экосистемы PAPI.
      Переопределять один hashCode вслепую опасно: семантика final-equals апстрима
      недоступна для сверки контракта «равные → равные хеши».
      Практического риска нет: реестр расширений PAPI ведётся по строковому
      getIdentifier(), объект расширения ключом hash-коллекций не используется.
      Exclude ограничен двумя нашими классами-плейсхолдерами, не паттерном глобально.
    -->
    <Match>
        <Class name="~dev\.raskol\.classes\.hook\.(Raskol|Flavor)Placeholder"/>
        <Bug pattern="HE_INHERITS_EQUALS_USE_HASHCODE"/>
    </Match>

</FindBugsFilter>

    <!-- 1.14.14 (фаза 1): правила для test-only                          -->
    <!-- ================================================================ -->

    <!--
      FE_FLOATING_POINT_EQUALITY / FL_FLOATS_AS_LOOP_COUNTERS в test-слое:
      BalanceSimulator (TTK-симуляция дуэлей) и SelftestRunner (headless-проверка
      формул) оперируют точными значениями из формул; равенства там осознанные,
      не требуют epsilon. Боевой код (VanillaDamageListener) исправлен в фазе 2
      epsilon-сравнением и НЕ исключён.
    -->
    <Match>
        <Class name="dev.raskol.classes.balance.BalanceSimulator"/>
        <Bug pattern="FE_FLOATING_POINT_EQUALITY,FL_FLOATS_AS_LOOP_COUNTERS"/>
    </Match>
    <Match>
        <Class name="dev.raskol.classes.selftest.SelftestRunner"/>
        <Bug pattern="FE_FLOATING_POINT_EQUALITY"/>
    </Match>

    <!-- ================================================================ -->
    <!-- 1.14.14 (фаза 2): апстрим-ограничение PlaceholderAPI             -->
    <!-- ================================================================ -->

    <!--
      HE_INHERITS_EQUALS_USE_HASHCODE для расширений PlaceholderAPI:
      в PlaceholderAPI 2.11.6 метод equals(Object) объявлен FINAL в
      me.clip.placeholderapi.expansion.PlaceholderExpansion (переопределение =
      compile error "overridden method is final"), при этом hashCode() апстрим
      НЕ предоставляет — любой сабкласс наследует final-equals + Object.hashCode,
      т.е. находка воспроизводится для ВСЕХ расширений экосистемы PAPI.
      Переопределять один hashCode вслепую опасно: семантика final-equals апстрима
      недоступна для сверки контракта «равные → равные хеши».
      Практического риска нет: реестр расширений PAPI ведётся по строковому
      getIdentifier(), объект расширения ключом hash-коллекций не используется.
      Exclude ограничен двумя нашими классами-плейсхолдерами, не паттерном глобально.
    -->
    <Match>
        <Class name="~dev\.raskol\.classes\.hook\.(Raskol|Flavor)Placeholder"/>
        <Bug pattern="HE_INHERITS_EQUALS_USE_HASHCODE"/>
    </Match>

    <!-- ================================================================ -->
    <!-- 1.15.8 (Волна 8): singleton-factory, MS_EXPOSE_REP ложноположителен -->
    <!-- ================================================================ -->

    <!--
      MS_EXPOSE_REP для WarlockAbilities.install(RaskolClasses): фабричный метод
      возвращает singleton-экземпляр по паттерну 1.14.14 (ST_WRITE-фикс —
      запись в static-поле вынесена из конструктора). Инстанс иммутабелен после
      установки (все мутабельные поля — instance, не static), публичность метода
      необходима для доступа из RaskolClasses.onEnable и CombatService.
      Реальный риск = 0: singleton единственный на весь жизненный цикл плагина.
    -->
    <Match>
        <Class name="dev.raskol.classes.ability.WarlockAbilities"/>
        <Method name="install"/>
        <Bug pattern="MS_EXPOSE_REP"/>
    </Match>

